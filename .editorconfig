# Thin formatter configuration. Analyzer/style rules come from FixPortal.CodeStyle;
# only documented project-specific exceptions belong below.

root = true

#### Baseline (applies to every file type) ####
[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

#### Project / config files (2-space convention) ####
[*.{csproj,fsproj,vbproj,proj,props,targets}]
indent_size = 2

[*.{json,yml,yaml,xml,config}]
indent_size = 2

[*.md]
# markdown line breaks are two trailing spaces — don't trim them
trim_trailing_whitespace = false

#### C# files ####
[*.cs]
end_of_line = crlf
indent_size = 4
indent_style = space
tab_width = 4
max_line_length = 120

# Roslyn formatter compatibility. FixPortal.CodeStyle owns these values, but
# dotnet format needs them in a hierarchical .editorconfig to activate its fixers.
csharp_prefer_braces = true:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# The upstream public API intentionally retains its established names.
dotnet_diagnostic.IDE1006.severity = none
resharper_inconsistent_naming_highlighting = none
